<?xml version="1.0" encoding="utf-8"?>
<!-- LibreBuds original artwork, "generic" earbuds, case open (final frame of avd_generic_open). Geometric drawing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Case opening, visible once the lid is up. -->
    <path android:name="cavity" android:fillColor="?android:attr/colorForeground" android:fillAlpha="0.3"
        android:pathData="M39,60H81A3,3 0,0 1 84,63V64H36V63A3,3 0,0 1 39,60Z" />
    <!-- The earbuds show only above the rim of the case. -->
    <group android:name="buds_window">
        <clip-path android:pathData="M0,0H108V64H0Z" />
        <group android:name="buds" android:translateY="-6">
            <path android:fillColor="?android:attr/colorForeground"
                android:pathData="M41,58A8,8 0,1 1 57,58A8,8 0,1 1 41,58ZM63,58A8,8 0,1 1 79,58A8,8 0,1 1 63,58Z" />
        </group>
    </group>
    <!-- Case body with the status light cut out. -->
    <path android:name="body" android:fillColor="?android:attr/colorForeground" android:fillType="evenOdd"
        android:pathData="M32,66H88A2,2 0,0 1 90,68V80A12,12 0,0 1 78,92H42A12,12 0,0 1 30,80V68A2,2 0,0 1 32,66ZM58.4,82A1.6,1.6 0,1 1 61.6,82A1.6,1.6 0,1 1 58.4,82Z" />
    <!-- Lid, hinged at the back-left corner of the rim. -->
    <group android:name="lid" android:pivotX="30" android:pivotY="64" android:rotation="-70">
        <path android:fillColor="?android:attr/colorForeground"
            android:pathData="M42,48H78A12,12 0,0 1 90,60V62A2,2 0,0 1 88,64H32A2,2 0,0 1 30,62V60A12,12 0,0 1 42,48Z" />
    </group>
</vector>
