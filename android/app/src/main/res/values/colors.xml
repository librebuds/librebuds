<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home-screen widget colors, following the system (Material You) palette. -->
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_accent">@android:color/system_accent1_600</color>
    <color name="widget_on_accent">@android:color/system_accent1_0</color>
    <!-- Case-open popup card. -->
    <color name="popup_background">@android:color/system_neutral1_50</color>
    <!-- Fixed, not dynamic: matches the video clip background so the card has no seam around it. -->
    <color name="popup_video_background">#FFFFFFFF</color>
    <color name="popup_text">@android:color/system_neutral1_900</color>
    <color name="popup_text_secondary">@android:color/system_neutral2_700</color>
    <!-- Notification accent: the launcher icon's teal, so the notification icon matches the app icon. -->
    <color name="notification_accent">#FF0D5156</color>
</resources>
